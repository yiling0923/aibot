# Copy this file to .env and fill in what you have.
DATABASE_URL=postgres://bot:bot@localhost:5432/livechat_bot
PORT=3000
# Used only by the automated tests. It is wiped on every run, so never point it at real data.
TEST_DATABASE_URL=postgres://bot:bot@localhost:5432/livechat_bot_test

# Phase 3 (AI layer). Not needed for the engine, the database or the tests.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OPENAI_MODEL=

# Phase 8 (LiveChat). Leave empty until then.
LIVECHAT_CLIENT_ID=
LIVECHAT_CLIENT_SECRET=
LIVECHAT_WEBHOOK_SECRET=
