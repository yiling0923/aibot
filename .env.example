# Copy this file to .env and fill in what you have.
DATABASE_URL=mysql://bot:bot@localhost:3306/livechat_bot
PORT=3000
# Used only by the automated tests. It is wiped on every run, so never point it at real data.
TEST_DATABASE_URL=mysql://bot:bot@localhost:3306/livechat_bot_test

# AI layer (optional). With no keys the bot works exactly as before, from its own keyword rules.
# Claude (Anthropic): picks the entry when no keyword matched, and describes new keywords.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# ChatGPT (OpenAI): phrases the knowledge base answer. Needs a model name, otherwise it stays off.
OPENAI_API_KEY=
OPENAI_MODEL=
# Safety limit on AI calls per hour. After this the bot answers without AI until the hour is over.
AI_MAX_CALLS_PER_HOUR=600

# Phase 8 (LiveChat). Leave empty until then.
LIVECHAT_CLIENT_ID=
LIVECHAT_CLIENT_SECRET=
LIVECHAT_WEBHOOK_SECRET=

# Signs the customer token that the merchant website sends with the chat. Change it for real use.
CUSTOMER_TOKEN_SECRET=demo-secret
# Set to off outside your own computer: it hides the fake-customer test buttons.
DEV_TOOLS=on

# Signs the control panel login cookie. Use a long random value outside your own computer.
SESSION_SECRET=dev-session-secret-change-me

# How long the LiveChat connector may take before the chat is handed to a person (milliseconds).
ASK_TIMEOUT_MS=8000

# Makes the AI keys saved on the merchant page unreadable in the database. Use a long random value outside your own computer, and do not change it later.
SECRETS_KEY=
# The address LiveChat uses to reach this bot (shown on the merchant page). Leave empty to use the address of the page you opened.
PUBLIC_URL=

# Alerts when the bot has a problem (all optional; set one or both). Leave empty to see problems in the panel only.
# A Slack, Discord or Teams incoming-webhook address (or any address that takes JSON):
ALERT_WEBHOOK_URL=
# A Telegram bot: make it with @BotFather, send it a message, then put its token and your chat id here:
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# The name shown at the start of each alert:
ALERT_NAME=LuckyPay AI bot
