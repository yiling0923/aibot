# Copy this file to .env and fill in what you have.
DATABASE_URL=mysql://bot:bot@localhost:3306/livechat_bot
PORT=3000
# Used only by the automated tests. It is wiped on every run, so never point it at real data.
TEST_DATABASE_URL=mysql://bot:bot@localhost:3306/livechat_bot_test

# AI layer (optional). With no keys the bot works exactly as before, from its own keyword rules.
# Claude (Anthropic): picks the entry when no keyword matched, and describes new keywords.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# ChatGPT (OpenAI): phrases the knowledge base answer. Needs a model name, otherwise it stays off.
OPENAI_API_KEY=
OPENAI_MODEL=
# Safety limit on AI calls per hour. After this the bot answers without AI until the hour is over.
AI_MAX_CALLS_PER_HOUR=600

# Phase 8 (LiveChat). Leave empty until then.
LIVECHAT_CLIENT_ID=
LIVECHAT_CLIENT_SECRET=
LIVECHAT_WEBHOOK_SECRET=

# Signs the customer token that the merchant website sends with the chat. Change it for real use.
CUSTOMER_TOKEN_SECRET=demo-secret
# Set to off outside your own computer: it hides the fake-customer test buttons.
DEV_TOOLS=on

# Signs the control panel login cookie. Use a long random value outside your own computer.
SESSION_SECRET=dev-session-secret-change-me
