diff -ruN a/internal/automation/ai_reply_attachment_test.go b/internal/automation/ai_reply_attachment_test.go
--- a/internal/automation/ai_reply_attachment_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/automation/ai_reply_attachment_test.go	2026-11-17 02:24:04.353102805 +0000
@@ -0,0 +1,30 @@
+package automation
+
+import (
+	"context"
+	"testing"
+
+	merchantautomation "livechat/internal/merchant/automation"
+)
+
+func TestServiceSendsAttachmentInfoToAIAndNeverUsesTheAnswerCacheForIt(t *testing.T) {
+	provider := &fakeConfigProvider{config: merchantautomation.AIChatConfig{Enabled: true, BaseURL: "https://ai.example", APIKey: "key"}}
+	client := &fakeAIReplyClient{response: map[string]any{"reply": "we got your picture"}}
+	writer := &fakeBotWriter{}
+	service := NewService(provider, client, writer)
+	service.Cache = fakeAnswerCache{response: map[string]any{"reply": "an old answer for this file name", "confidence": 0.99}, found: true}
+	input := TriggerInput{ConversationID: 7, Question: "MMU (3).jpg", Attachment: &AttachmentInfo{Kind: "image", Name: "MMU (3).jpg", MIMEType: "image/jpeg", Size: 88000}}
+	if err := service.DispatchAIReply(context.Background(), "9", input); err != nil {
+		t.Fatal(err)
+	}
+	if client.calls != 1 || len(writer.messages) != 1 || writer.messages[0].request.Body != "we got your picture" {
+		t.Fatalf("a picture must go to the AI, never to the cache: calls=%d messages=%+v", client.calls, writer.messages)
+	}
+	att, ok := client.payload["attachment"].(map[string]any)
+	if !ok || att["kind"] != "image" || att["name"] != "MMU (3).jpg" || att["mime_type"] != "image/jpeg" {
+		t.Fatalf("expected the attachment in the AI payload, got %+v", client.payload)
+	}
+	if _, has := client.payload["member"]; has {
+		t.Fatalf("no member was given, none must be sent: %+v", client.payload)
+	}
+}
diff -ruN a/internal/widget/ai_attachment_test.go b/internal/widget/ai_attachment_test.go
--- a/internal/widget/ai_attachment_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/widget/ai_attachment_test.go	2026-11-17 02:24:04.355678800 +0000
@@ -0,0 +1,41 @@
+package widget
+
+import (
+	"context"
+	"testing"
+
+	"livechat/internal/tenant"
+)
+
+func TestServiceTellsTheAIBotAboutAPictureTheCustomerSends(t *testing.T) {
+	aiReplies := &fakeAIReplyDispatcher{}
+	service := Service{
+		Finder: &fakeDataFinder{
+			addResponse: ConversationResponse{
+				Conversation: ConversationPayload{
+					ID:       123,
+					PublicID: "01JCONV",
+					Messages: []MessagePayload{
+						{ID: 1, SenderType: "visitor", Body: "slip.png", MessageType: "image", Attachment: &AttachmentPayload{Kind: "image", Name: "slip.png", MIMEType: "image/png", Size: 2048}},
+					},
+				},
+			},
+		},
+		Realtime:  &fakeRealtimeGateway{},
+		AIReplies: aiReplies,
+	}
+	if _, err := service.AddMessage(context.Background(), tenant.ID("1"), "01JCONV", AddMessageRequest{
+		VisitorSessionID: "session-123",
+		Body:             "slip.png",
+		Attachment:       &AttachmentPayload{Kind: "image", Name: "slip.png", URL: "/uploads/slip.png", MIMEType: "image/png", Size: 2048},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !aiReplies.called {
+		t.Fatal("a picture must reach the AI bot too")
+	}
+	got := aiReplies.input.Attachment
+	if got == nil || got.Kind != "image" || got.Name != "slip.png" || got.MIMEType != "image/png" || got.Size != 2048 || aiReplies.input.Question != "slip.png" {
+		t.Fatalf("expected the picture's name and kind in the AI trigger, got question=%q attachment=%+v", aiReplies.input.Question, got)
+	}
+}
