diff -ruN a/internal/automation/ai_reply_member_test.go b/internal/automation/ai_reply_member_test.go
--- a/internal/automation/ai_reply_member_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/automation/ai_reply_member_test.go	2026-11-17 01:36:43.965259991 +0000
@@ -0,0 +1,37 @@
+package automation
+
+import (
+	"context"
+	"testing"
+
+	merchantautomation "livechat/internal/merchant/automation"
+)
+
+func TestServiceSendsMemberToAIAndNeverUsesTheAnswerCacheForThem(t *testing.T) {
+	provider := &fakeConfigProvider{config: merchantautomation.AIChatConfig{Enabled: true, BaseURL: "https://ai.example", APIKey: "key"}}
+	client := &fakeAIReplyClient{response: map[string]any{"reply": "your balance is 100"}}
+	writer := &fakeBotWriter{}
+	service := NewService(provider, client, writer)
+	service.Cache = fakeAnswerCache{response: map[string]any{"reply": "someone else's balance", "confidence": 0.99}, found: true}
+	input := TriggerInput{ConversationID: 5, Question: "check my balance", Member: &MemberInfo{ExternalID: " 8841 ", Name: "Tom", Rank: "GOLD"}}
+	if err := service.DispatchAIReply(context.Background(), "9", input); err != nil {
+		t.Fatal(err)
+	}
+	if client.calls != 1 || len(writer.messages) != 1 || writer.messages[0].request.Body != "your balance is 100" {
+		t.Fatalf("a member's question must go to the AI, never to the cache: calls=%d messages=%+v", client.calls, writer.messages)
+	}
+	member, ok := client.payload["member"].(map[string]any)
+	if !ok || member["id"] != "8841" || member["name"] != "Tom" || member["rank"] != "GOLD" {
+		t.Fatalf("expected the member in the AI payload, got %+v", client.payload)
+	}
+	// a guest: no member in the payload, and the cache is used as before
+	client2 := &fakeAIReplyClient{response: map[string]any{"reply": "network"}}
+	service2 := NewService(provider, client2, &fakeBotWriter{})
+	service2.Cache = fakeAnswerCache{response: map[string]any{"reply": "cached", "confidence": 0.92}, found: true}
+	if err := service2.DispatchAIReply(context.Background(), "9", TriggerInput{ConversationID: 6, Question: "how to deposit"}); err != nil {
+		t.Fatal(err)
+	}
+	if client2.calls != 0 {
+		t.Fatalf("a guest question may use the cache, calls=%d", client2.calls)
+	}
+}
