{
  "name": "livechat-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-merchant LiveChat AI bot: engine, API and database (runs on localhost)",
  "scripts": {
    "dev": "npm run build && tsx watch src/server/index.ts",
    "start": "npm run build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "user:add": "tsx src/auth/addUser.ts",
    "key:create": "tsx src/connector/createKey.ts",
    "eval:report": "tsx scripts/evalReport.ts",
    "build": "node scripts/cleanWeb.mjs && vite build",
    "dev:web": "vite"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fastify/static": "^10.1.8",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "openai": "^7.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
